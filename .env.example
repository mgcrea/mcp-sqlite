# SQLite connection
SQLITE_DB_PATH=./data.db
SQLITE_READONLY=true

# Server
MCP_PORT=8080
MCP_HOST=0.0.0.0

# Access control (mcp-policy-guard). Leave these unset to run exactly as this server did
# before the guard existed: every caller served unauthenticated, no decision point consulted.
# The platform injects them on deployments that have an identity configured.
# MCP_REQUIRE_AUTH=true
# MCP_AUTH_ISSUER=https://keycloak.rgis.dev/realms/ai-hub
# MCP_TOOL_ID=
# MCP_POLICY_URL=
# MCP_POLICY_FAIL_MODE=closed
